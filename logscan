#!/bin/bash
# logscan - Security/Traffic Analytics Dashboard
# Usage: logscan [--help] [--port PORT] [--reload] [--no-browser]

set -e

# Resolve symlinks to get real script directory
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
VENV_DIR="/tmp/opencode/logscan-venv"
PORT=""
RELOAD=""
OPEN_BROWSER=true

# Function to find available port
find_available_port() {
  local port=$((9000 + RANDOM % 1000))
  while lsof -i :$port &>/dev/null 2>&1; do
    port=$((9000 + RANDOM % 1000))
  done
  echo $port
}

# Parse arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    --help)
      echo "logscan - Security/Traffic Analytics Dashboard"
      echo ""
      echo "Usage: logscan [OPTIONS]"
      echo ""
      echo "Options:"
      echo "  --help              Show this help message"
      echo "  --port PORT         Run on PORT (default: random 9000-9999)"
      echo "  --reload            Enable auto-reload on code changes"
      echo "  --no-browser        Don't open browser automatically"
      echo ""
      echo "Examples:"
      echo "  logscan                    # Start on random port, open browser"
      echo "  logscan --port 8080        # Start on port 8080"
      echo "  logscan --reload           # Dev mode with auto-reload"
      echo "  logscan --no-browser       # Start but don't open browser"
      echo ""
      echo "Once started:"
      echo "  • Browser opens automatically"
      echo "  • Press Ctrl+C to stop"
      exit 0
      ;;
    --port)
      PORT="$2"
      shift 2
      ;;
    --reload)
      RELOAD="--reload"
      shift
      ;;
    --no-browser)
      OPEN_BROWSER=false
      shift
      ;;
    *)
      echo "Unknown option: $1"
      echo "Run 'logscan --help' for usage information"
      exit 1
      ;;
  esac
done

# Use random port if not specified
if [ -z "$PORT" ]; then
  PORT=$(find_available_port)
fi

# Check venv exists
if [ ! -d "$VENV_DIR" ]; then
  echo "❌ Error: Virtual environment not found at $VENV_DIR"
  echo "Please restore it from backup or reinstall"
  exit 1
fi

# Check Python
if [ ! -f "$VENV_DIR/bin/python" ]; then
  echo "❌ Error: Python not found in venv"
  exit 1
fi

# Get VPS IP address
get_ip() {
  # Try to get external IP
  IP=$(hostname -I 2>/dev/null | awk '{print $1}')
  if [ -z "$IP" ] || [ "$IP" = "127.0.0.1" ]; then
    # Fallback: try to get IP from network interfaces
    IP=$(ip route get 1 2>/dev/null | awk '{print $NF;exit}')
  fi
  if [ -z "$IP" ] || [ "$IP" = "127.0.0.1" ]; then
    # Last resort: use localhost
    IP="localhost"
  fi
  echo "$IP"
}

VPS_IP=$(get_ip)

# Start server
echo "🚀 Starting logscan v52.1 (enhanced edition with 10 interactive features)..."
echo ""
echo "📍 Access URL (from outside):"
echo "   http://$VPS_IP:$PORT"
echo ""
echo "🌐 Local access:"
echo "   http://localhost:$PORT"
echo ""
echo "⏹️  Press Ctrl+C to stop"
echo ""

# Open browser if requested (only on localhost)
if [ "$OPEN_BROWSER" = true ] && [ "$VPS_IP" != "localhost" ]; then
  sleep 2 &  # Give server time to start
  SLEEP_PID=$!

  # Try to open browser on local machine
  if command -v xdg-open &>/dev/null; then
    xdg-open "http://localhost:$PORT" &>/dev/null &
  elif command -v open &>/dev/null; then
    open "http://localhost:$PORT" &>/dev/null &
  elif command -v firefox &>/dev/null; then
    firefox "http://localhost:$PORT" &>/dev/null &
  elif command -v chromium &>/dev/null; then
    chromium "http://localhost:$PORT" &>/dev/null &
  fi

  wait $SLEEP_PID 2>/dev/null || true
elif [ "$OPEN_BROWSER" = true ]; then
  sleep 2 &
  SLEEP_PID=$!

  if command -v xdg-open &>/dev/null; then
    xdg-open "http://127.0.0.1:$PORT" &>/dev/null &
  elif command -v open &>/dev/null; then
    open "http://127.0.0.1:$PORT" &>/dev/null &
  elif command -v firefox &>/dev/null; then
    firefox "http://127.0.0.1:$PORT" &>/dev/null &
  elif command -v chromium &>/dev/null; then
    chromium "http://127.0.0.1:$PORT" &>/dev/null &
  fi

  wait $SLEEP_PID 2>/dev/null || true
fi

cd "$SCRIPT_DIR" || exit 1

# Set allowed hosts environment variable
export LOGSCAN_ALLOWED_HOSTS="localhost,127.0.0.1,$VPS_IP"
if [ "$VPS_IP" != "localhost" ]; then
  export LOGSCAN_ALLOWED_HOSTS="$LOGSCAN_ALLOWED_HOSTS,0.0.0.0"
fi

# Date temporare pe disk (97GB liberi) -- suprascrie cu LOGSCAN_WORK_ROOT=... daca vrei altceva
export LOGSCAN_WORK_ROOT="${LOGSCAN_WORK_ROOT:-/tmp/logscan-work}"
mkdir -p "$LOGSCAN_WORK_ROOT" && chmod 700 "$LOGSCAN_WORK_ROOT"

# Memorie maxima pentru analiza logurilor: 6.5 GB din 8GB disponibili
# Permite procesarea de log-uri mari (2-3 GB decomprimat). Suprascrie cu LOGSCAN_MAX_RSS_MB=...
export LOGSCAN_MAX_RSS_MB="${LOGSCAN_MAX_RSS_MB:-6500}"

# Dimensiunea maxima a upload-ului: 50 GB. Suprascrie cu LOGSCAN_MAX_UPLOAD_MB=...
export LOGSCAN_MAX_UPLOAD_MB="${LOGSCAN_MAX_UPLOAD_MB:-50000}"

# Start app
"$VENV_DIR/bin/python" -m uvicorn app:app --host 0.0.0.0 --port "$PORT" $RELOAD
